<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Ray-Ban App"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status: Not connected"
        android:textSize="14sp"
        android:padding="12dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/mockDeviceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Pair Mock Device"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/powerOnButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Power On + Don"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/selectVideoButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Select Video (h265)"
        android:enabled="false"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/startStreamButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Start Camera Stream"
        android:enabled="false"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/askAiButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5. Ask AI (Voice)"
        android:enabled="false"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#6200EE"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/aiResponseText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI: Waiting for question..."
        android:textSize="16sp"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:scaleType="fitCenter"/>

</LinearLayout>
